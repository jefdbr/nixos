{
  pkgs,
  config,
  user,
  ...
}:
let
  colors = config.lib.stylix.colors.withHashtag;
in
{
  # One place for the editor, for every shell and session.
  environment.variables = {
    EDITOR = "emacsclient -nw";
    VISUAL = "emacsclient -nw";
  };

  home-manager.users.${user} = {
    stylix.targets.emacs.enable = false;

    xdg.configFile."doom/stylix-colors.el".text = ''
      ;;; stylix-colors.el --- Generated by Nix -*- lexical-binding: t; -*-
      (defvar stylix-base00 "${colors.base00}")
      (defvar stylix-base01 "${colors.base01}")
      (defvar stylix-base02 "${colors.base02}")
      (provide 'stylix-colors)
    '';

    programs.emacs = {
      enable = true;
      package = pkgs.emacs-pgtk;
      extraPackages = epkgs: with epkgs; [ vterm ];
    };

    # No `package` here: it defaults to programs.emacs's final package,
    # so the daemon also gets vterm.
    services.emacs = {
      enable = true;
      client.enable = true;
      startWithUserSession = "graphical";
    };

    home.packages = with pkgs; [
      cmake
      gcc
      libtool
      gnumake
      binutils
      gnutls
      imagemagick
      zstd
      editorconfig-core-c
      sqlite
      vips
      ffmpegthumbnailer
      mediainfo
      p7zip
      texliveSmall
      (aspellWithDicts (
        ds: with ds; [
          en
          nl
        ]
      ))
      nodejs
      typescript-language-server
      vscode-langservers-extracted
      clang-tools
      ruff
      pyright
      texlab
      nixd
      nil
      tree-sitter
      shellcheck
      statix
      rustc
      cargo
      rustfmt
      clippy
      rust-analyzer
    ];

    home.sessionPath = [ "$HOME/.config/emacs/bin" ];

    home.sessionVariables.RUST_SRC_PATH = "${pkgs.rust.packages.stable.rustPlatform.rustLibSrc}";

    xdg.desktopEntries = {
      "emacs" = {
        name = "Emacs";
        noDisplay = true;
      };
      "emacsclient-mail" = {
        name = "Emacs (Client) Mail";
        noDisplay = true;
      };
      "emacs-mail" = {
        name = "Emacs Mail";
        noDisplay = true;
      };
    };
  };
}
